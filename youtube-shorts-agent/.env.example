# Claude API key (https://console.anthropic.com/). Not needed if you ran `ant auth login`.
ANTHROPIC_API_KEY=

# YouTube Data API v3 key for niche research (Google Cloud Console > APIs & Services > Credentials)
YOUTUBE_API_KEY=

# OAuth client file (Desktop app type) used to upload to YOUR channel
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_TOKEN_FILE=token.json

# Optional: free key from https://www.pexels.com/api/ for real stock footage backgrounds.
# Without it, animated gradient backgrounds are used.
PEXELS_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-opus-5-5
TTS_VOICE=en-US-AndrewMultilingualNeural
REGION_CODE=US
LANGUAGE=en
CAPTION_FONT=DejaVu Sans
OUTPUT_DIR=output
